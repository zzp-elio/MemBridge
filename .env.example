# OpenAI SDK compatible chat completions endpoint.
# API_KEY and BASE_URL are shared. MODEL_NAME is the fallback for both roles.
# Set ANSWER_MODEL or JUDGE_MODEL when the two roles should differ.
API_KEY=
# The base URL for the API.
#BASE_URL=
MODEL_NAME=gpt-4o-mini
#ANSWER_MODEL=
#JUDGE_MODEL=
# Optional bearer token sent to the memory server under test.
#MEMORY_SERVER_TOKEN=
